    <PackageJsonDependenciesRxjs Condition="$(PackageJsonDependenciesRxjs) == ''">^7.8.2</PackageJsonDependenciesRxjs>
    <PackageJsonDependenciesTypeorm Condition="$(PackageJsonDependenciesTypeorm) == ''">^0.3.31</PackageJsonDependenciesTypeorm>
