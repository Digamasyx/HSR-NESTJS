    <PackageJsonJestModulenamemapperFile Condition="$(PackageJsonJestModulenamemapperFile) == ''">&lt;rootDir&gt;/file/$1</PackageJsonJestModulenamemapperFile>
    <PackageJsonJestModulenamemapperGlobals Condition="$(PackageJsonJestModulenamemapperGlobals) == ''">&lt;rootDir&gt;/globals/$1</PackageJsonJestModulenamemapperGlobals>
    <PackageJsonJestModulenamemapperRoles Condition="$(PackageJsonJestModulenamemapperRoles) == ''">&lt;rootDir&gt;/roles/$1</PackageJsonJestModulenamemapperRoles>
    <PackageJsonJestModulenamemapperTalent Condition="$(PackageJsonJestModulenamemapperTalent) == ''">&lt;rootDir&gt;/talent/$1</PackageJsonJestModulenamemapperTalent>
    <PackageJsonJestModulenamemapperUser Condition="$(PackageJsonJestModulenamemapperUser) == ''">&lt;rootDir&gt;/user/$1</PackageJsonJestModulenamemapperUser>
