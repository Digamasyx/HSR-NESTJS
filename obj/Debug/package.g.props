    <PackageJsonDevdependenciesTsconfigPaths Condition="$(PackageJsonDevdependenciesTsconfigPaths) == ''">^4.2.0</PackageJsonDevdependenciesTsconfigPaths>
    <PackageJsonDevdependenciesTypescript Condition="$(PackageJsonDevdependenciesTypescript) == ''">npm:@typescript/typescript6@^6.0.0</PackageJsonDevdependenciesTypescript>
    <PackageJsonDevdependenciesTypescript7 Condition="$(PackageJsonDevdependenciesTypescript7) == ''">npm:typescript@^7.0.2</PackageJsonDevdependenciesTypescript7>
    <PackageJsonOverridesTar Condition="$(PackageJsonOverridesTar) == ''">&gt;=7.5.20</PackageJsonOverridesTar>
    <PackageJsonOverridesTsJestTypescript Condition="$(PackageJsonOverridesTsJestTypescript) == ''">npm:@typescript/typescript6@^6.0.0</PackageJsonOverridesTsJestTypescript>
    <PackageJsonJestModulefileextensions Condition="$(PackageJsonJestModulefileextensions) == ''">[
  "js",
  "json",
  "ts"
]</PackageJsonJestModulefileextensions>
    <PackageJsonJestRootdir Condition="$(PackageJsonJestRootdir) == ''">src</PackageJsonJestRootdir>
    <PackageJsonJestTestregex Condition="$(PackageJsonJestTestregex) == ''">.*\.spec\.ts$</PackageJsonJestTestregex>
    <PackageJsonJestTransformTJS Condition="$(PackageJsonJestTransformTJS) == ''">ts-jest</PackageJsonJestTransformTJS>
    <PackageJsonJestCollectcoveragefrom Condition="$(PackageJsonJestCollectcoveragefrom) == ''">[
  "**/*.(t|j)s"
]</PackageJsonJestCollectcoveragefrom>
    <PackageJsonJestCoveragedirectory Condition="$(PackageJsonJestCoveragedirectory) == ''">../coverage</PackageJsonJestCoveragedirectory>
    <PackageJsonJestTestenvironment Condition="$(PackageJsonJestTestenvironment) == ''">node</PackageJsonJestTestenvironment>
    <PackageJsonJestModulenamemapperAuth Condition="$(PackageJsonJestModulenamemapperAuth) == ''">&lt;rootDir&gt;/auth/$1</PackageJsonJestModulenamemapperAuth>
    <PackageJsonJestModulenamemapperChar Condition="$(PackageJsonJestModulenamemapperChar) == ''">&lt;rootDir&gt;/char/$1</PackageJsonJestModulenamemapperChar>
