<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <PackageJsonName Condition="$(PackageJsonName) == ''">hsr</PackageJsonName>
    <PackageJsonVersion Condition="$(PackageJsonVersion) == ''">1.0.0-alpha.1</PackageJsonVersion>
    <PackageJsonDescription Condition="$(PackageJsonDescription) == ''"></PackageJsonDescription>
    <PackageJsonAuthor Condition="$(PackageJsonAuthor) == ''">DigamaSyx</PackageJsonAuthor>
    <PackageJsonPrivate Condition="$(PackageJsonPrivate) == ''">true</PackageJsonPrivate>
    <PackageJsonLicense Condition="$(PackageJsonLicense) == ''">LGPL-3.0-only</PackageJsonLicense>
    <PackageJsonScriptsBuild Condition="$(PackageJsonScriptsBuild) == ''">nest build</PackageJsonScriptsBuild>
    <PackageJsonScriptsFormat Condition="$(PackageJsonScriptsFormat) == ''">prettier --write "src/**/*.ts" "test/**/*.ts"</PackageJsonScriptsFormat>
    <PackageJsonScriptsStart Condition="$(PackageJsonScriptsStart) == ''">nest start</PackageJsonScriptsStart>
    <PackageJsonScriptsTypeCheck Condition="$(PackageJsonScriptsTypeCheck) == ''">npx tsc7 --noEmit</PackageJsonScriptsTypeCheck>
    <PackageJsonScriptsStartDev Condition="$(PackageJsonScriptsStartDev) == ''">nest start --watch</PackageJsonScriptsStartDev>
    <PackageJsonScriptsStartDebug Condition="$(PackageJsonScriptsStartDebug) == ''">nest start --debug --watch</PackageJsonScriptsStartDebug>
    <PackageJsonScriptsStartProd Condition="$(PackageJsonScriptsStartProd) == ''">node dist/main</PackageJsonScriptsStartProd>
    <PackageJsonScriptsLint Condition="$(PackageJsonScriptsLint) == ''">eslint "{src,apps,libs,test}/**/*.ts" --fix</PackageJsonScriptsLint>
    <PackageJsonScriptsTest Condition="$(PackageJsonScriptsTest) == ''">jest</PackageJsonScriptsTest>
    <PackageJsonScriptsTestWatch Condition="$(PackageJsonScriptsTestWatch) == ''">jest --watch</PackageJsonScriptsTestWatch>
    <PackageJsonScriptsTestVerbose Condition="$(PackageJsonScriptsTestVerbose) == ''">jest --verbose</PackageJsonScriptsTestVerbose>
    <PackageJsonScriptsTestOpenhandles Condition="$(PackageJsonScriptsTestOpenhandles) == ''">jest --detectOpenHandles</PackageJsonScriptsTestOpenhandles>
    <PackageJsonScriptsTestCov Condition="$(PackageJsonScriptsTestCov) == ''">jest --coverage</PackageJsonScriptsTestCov>
    <PackageJsonScriptsTestDebug Condition="$(PackageJsonScriptsTestDebug) == ''">node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand</PackageJsonScriptsTestDebug>
    <PackageJsonScriptsTestE2e Condition="$(PackageJsonScriptsTestE2e) == ''">jest --config ./test/jest-e2e.json</PackageJsonScriptsTestE2e>
    <PackageJsonDependenciesNestjsCommon Condition="$(PackageJsonDependenciesNestjsCommon) == ''">^11.2.1</PackageJsonDependenciesNestjsCommon>
    <PackageJsonDependenciesNestjsConfig Condition="$(PackageJsonDependenciesNestjsConfig) == ''">^4.0.4</PackageJsonDependenciesNestjsConfig>
