<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.VisualStudio.JavaScript.Sdk/1.0.6311650" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <!-- Define o projeto como um servidor Node (NestJS) -->
    <ProjectTypes>node</ProjectTypes>
    <!-- O script do seu package.json que o botão Play (F5) deve disparar -->
    <StartupCommand>npm run start:debug</StartupCommand>
    <StartupCommandWorkingDirectory>$(MSBuildProjectDirectory)\</StartupCommandWorkingDirectory>
    <DefaultLaunchUrl>http://localhost:3000</DefaultLaunchUrl>
  </PropertyGroup>
  <PropertyGroup>
    <!-- Configura o Test Explorer para entender seus testes com Jest -->
    <JavaScriptTestRoot>src\</JavaScriptTestRoot>
    <JavaScriptTestFramework>Jest</JavaScriptTestFramework>
    <TestCommand>npm run test</TestCommand>
    <BuildCommand>npm run start:debug</BuildCommand>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="HSR-NESTJS.slnx" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Properties\" />
  </ItemGroup>
  <ItemGroup>
    <TypeScriptConfiguration Include="HSR-NESTJS.slnx" />
  </ItemGroup>
</Project>